# ==============================================================================
# NOTARI 2.0 - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# DO NOT put real production credentials in this file or commit .env.local to Git.
# ==============================================================================

# Application URL & Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database: MongoDB Connection String
# ------------------------------------------------------------------------------
# Local MongoDB Community Server:
MONGODB_URI=mongodb://localhost:27017/notari_oau
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/notari_oau?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Authentication: Auth.js / NextAuth v5
# ------------------------------------------------------------------------------
# Generate a secure 32-byte secret with: openssl rand -base64 32
AUTH_SECRET=changeme_in_production_min_32_random_bytes_generated
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Development Account Seeding (Used by: npm run db:seed)
# ------------------------------------------------------------------------------
# NOTE: The seed script is strictly intended for local development.
# Execution in production (NODE_ENV=production) is unconditionally disabled.
#
# The seed password variables below are REQUIRED to execute `npm run db:seed`.
# Set strong development passwords (min. 8 characters) in your private .env.local.
# Tip: Generate random passwords with: openssl rand -base64 16
# NEVER commit real passwords or your .env.local file to version control.
# ------------------------------------------------------------------------------

# Superadmin Account Seed (Required for db:seed)
SEED_ADMIN_NAME="Super Administrator"
SEED_ADMIN_EMAIL=admin@notari.oau.edu.ng
SEED_ADMIN_PASSWORD=your_secure_dev_admin_password_here

# Organizer Account Seed (Required for db:seed)
SEED_ORGANIZER_NAME="OAU Tech Innovation Club"
SEED_ORGANIZER_EMAIL=organizer@notari.oau.edu.ng
SEED_ORGANIZER_PASSWORD=your_secure_dev_organizer_password_here

# Student Account Seed (Required for db:seed)
SEED_STUDENT_NAME="Adeola Johnson"
SEED_STUDENT_EMAIL=student@notari.oau.edu.ng
SEED_STUDENT_PASSWORD=your_secure_dev_student_password_here
SEED_STUDENT_MATRIC=CSC/2021/042

# ------------------------------------------------------------------------------
# Payment Gateway: Paystack (Optional for Phase 1 - Scaffolding Boundaries)
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_dummy_key_notari_integration
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_dummy_key_notari_integration

# ------------------------------------------------------------------------------
# Media Storage: Cloudinary (Optional for Phase 1 - Scaffolding Boundaries)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=dummy_cloud_name
CLOUDINARY_API_KEY=dummy_api_key
CLOUDINARY_API_SECRET=dummy_api_secret

# ------------------------------------------------------------------------------
# Email Notifications: Resend / SMTP (Optional for Phase 1 - Scaffolding Boundaries)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_dummy_api_key
EMAIL_FROM=NOTARI OAU <notifications@notari.oau.edu.ng>
