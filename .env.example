# ==============================================================================
# NOTARI 2.0 - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# DO NOT put real production credentials in this file or commit .env.local to Git.
# ==============================================================================

# Application URL & Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database: MongoDB Connection String
# ------------------------------------------------------------------------------
# Local MongoDB Community Server:
MONGODB_URI=mongodb://localhost:27017/notari_oau
# Production MongoDB Atlas (Cluster with TLS & retryWrites):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/notari_oau?retryWrites=true&w=majority&maxPoolSize=10

# ------------------------------------------------------------------------------
# Authentication: Auth.js / NextAuth v5
# ------------------------------------------------------------------------------
# Generate a secure 32-byte secret with: openssl rand -base64 32
AUTH_SECRET=changeme_in_production_min_32_random_bytes_generated
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Payment Gateway: Paystack
# ------------------------------------------------------------------------------
# Test Mode (Use during staging/development):
PAYSTACK_SECRET_KEY=sk_test_your_paystack_test_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_test_public_key
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/verify

# Live Mode (For production deployment only — configure via environment dashboard):
# PAYSTACK_SECRET_KEY=sk_live_your_paystack_live_secret_key
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_live_public_key

# ------------------------------------------------------------------------------
# Media Storage: Cloudinary (Event Flyers & Verification Documents)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Email Notifications: Resend (Transactional Pass & Reminder Delivery)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=NOTARI OAU <notifications@notari.oau.edu.ng>
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# ------------------------------------------------------------------------------
# Scheduled Tasks & Cron Security: Vercel Cron Jobs
# ------------------------------------------------------------------------------
# Generate a secure 32-byte secret with: openssl rand -hex 32
# Used to authenticate scheduled runners hitting /api/cron/*
CRON_SECRET=your_cron_secret_min_32_hex_characters

# ------------------------------------------------------------------------------
# Development Account Seeding (Used only by: npm run db:seed)
# ------------------------------------------------------------------------------
# NOTE: The seed script is strictly intended for local development.
# Execution in production (NODE_ENV=production) is unconditionally disabled.
SEED_ADMIN_NAME="Super Administrator"
SEED_ADMIN_EMAIL=admin@notari.oau.edu.ng
SEED_ADMIN_PASSWORD=your_secure_dev_admin_password_here

SEED_ORGANIZER_NAME="OAU Tech Innovation Club"
SEED_ORGANIZER_EMAIL=organizer@notari.oau.edu.ng
SEED_ORGANIZER_PASSWORD=your_secure_dev_organizer_password_here

SEED_STUDENT_NAME="Adeola Johnson"
SEED_STUDENT_EMAIL=student@notari.oau.edu.ng
SEED_STUDENT_PASSWORD=your_secure_dev_student_password_here
SEED_STUDENT_MATRIC=CSC/2021/042
